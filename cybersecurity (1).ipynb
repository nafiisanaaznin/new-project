    "# =========================\n",
    "# 19. Per-class accuracy\n",
    "# =========================\n",
    "cm = confusion_matrix(y_true, y_pred)\n",
    "class_acc = cm.diagonal() / cm.sum(axis=1)\n",
    "\n",
    "print(\"\\nPer-class accuracy:\")\n",
    "for i, acc in enumerate(class_acc):\n",
    "    print(f\"{idx_to_class[i]}: {acc:.4f}\")"
   ]
